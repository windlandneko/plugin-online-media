{
  "name": "Online Media · Native Tracks",
  "identifier": "io.iina.ytdl",
  "version": "0.10.0",
  "ghRepo": "windlandneko/plugin-online-media",
  "ghVersion": 13,
  "description": "Online media with native video, audio and dual-subtitle track selection. Fork of iina/plugin-online-media.",
  "author": {
    "name": "IINA Developers",
    "email": "developers@iina.io",
    "url": "https://iina.io"
  },
  "entry": "dist/index.js",
  "globalEntry": "dist/global.js",
  "permissions": ["show-osd", "file-system", "network-request"],
  "allowedDomains": ["github.com"],
  "preferencesPage": "pref.html",
  "preferenceDefaults": {
    "ytdl_path": "",
    "js_runtime": "",
    "excluded_urls": "",
    "try_ytdl_first": false,
    "raw_options": "",
    "include_subs": true,
    "include_auto_subs": false,
    "video_quality": "best",
    "max_video_height": 1080,
    "custom_ytdl_format": "",
    "ytdl_format": ""
  }
}
